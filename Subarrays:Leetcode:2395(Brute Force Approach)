public class Solution {
    public static boolean findSubarrays(int[] nums) {
        int n = nums.length;
        for (int i = 0; i < n - 1; i++) {
            int sum1 = nums[i] + nums[i + 1];
            for (int j = i + 1; j < n - 1; j++) {
                int sum2 = nums[j] + nums[j + 1];
                if (sum1 == sum2) {
                    return true;
                }
            }
        }
        return false; 
    }
    public static void main(String[] args) {
        int[] nums1 = {4, 2, 4};
        System.out.println(findSubarrays(nums1)); // Output: true
        int[] nums2 = {1, 2, 3, 4};
        System.out.println(findSubarrays(nums2)); // Output: false
    }
}
