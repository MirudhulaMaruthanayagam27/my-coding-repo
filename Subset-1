import java.util.*;
public class SubsetExample {
    public static void main(String[] args) {
        subset("", "abc");
    }
    static void subset(String p, String up) {
        if (up.isEmpty()) {
            System.out.println(p);
            return;
        }
        char ch = up.charAt(0);
        // Exclude
        subset(p, up.substring(1));
       // Include
        subset(p + ch, up.substring(1));
    }}
