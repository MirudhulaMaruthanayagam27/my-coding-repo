class Stream {
    public static void main(String[] args) {
        System.out.println(skip("baccdah"));                // Output: bccdh
        System.out.println(skipApple("bapplecdappleh"));    // Output: bcdh
        System.out.println(skipAppNotApple("bapplecdappleh")); // Output: bapplecdh
    }
    // Skip all 'a' characters
    static String skip(String up) {
        if (up.isEmpty()) {
            return "";
        }
        char ch = up.charAt(0);
        if (ch == 'a') {
            return skip(up.substring(1));
        } else {
            return ch + skip(up.substring(1));
        }
    }
    // Skip all occurrences of "apple"
    static String skipApple(String up) {
        if (up.isEmpty()) {
            return "";
        }
        if (up.startsWith("apple")) {
            return skipApple(up.substring(5));
        } else {
            return up.charAt(0) + skipApple(up.substring(1));
        }
    }
    // Skip "app" but not "apple"
    static String skipAppNotApple(String up) {
        if (up.isEmpty()) {
            return "";
        }
        if (up.startsWith("app") && !up.startsWith("apple")){
            // skip "app" substring (3 chars)
            return skipAppNotApple(up.substring(3));
        } else {
            return up.charAt(0) + skipAppNotApple(up.substring(1));
        }
    }
}
